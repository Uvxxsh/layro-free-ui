{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "theme",
  "title": "Layro Free theme",
  "description": "Success, warning and info colours, two shadows, and the enter/exit and AI animations the components use. Works on top of any shadcn/ui theme.",
  "cssVars": {
    "theme": {
      "shadow-float": "0 1px 2px oklch(0 0 0 / 0.06), 0 8px 24px oklch(0 0 0 / 0.1)",
      "shadow-overlay": "0 2px 6px oklch(0 0 0 / 0.08), 0 24px 64px oklch(0 0 0 / 0.18)",
      "ease-out-soft": "cubic-bezier(0.22, 1, 0.36, 1)",
      "animate-fade-in": "layro-fade-in 180ms var(--ease-out-soft)",
      "animate-fade-out": "layro-fade-out 120ms ease-in",
      "animate-pop-in": "layro-pop-in 160ms var(--ease-out-soft)",
      "animate-pop-out": "layro-pop-out 110ms ease-in",
      "animate-dialog-in": "layro-dialog-in 220ms var(--ease-out-soft)",
      "animate-dialog-out": "layro-dialog-out 140ms ease-in",
      "animate-shimmer": "layro-shimmer 2.2s linear infinite",
      "animate-caret": "layro-caret 1.05s steps(1, end) infinite",
      "animate-word-in": "layro-word-in 380ms var(--ease-out-soft) both",
      "animate-dot": "layro-dot 1.25s ease-in-out infinite"
    },
    "light": {
      "success": "oklch(0.508 0.118 165.612)",
      "success-foreground": "oklch(0.985 0 0)",
      "warning": "oklch(0.525 0.155 48)",
      "warning-fill": "oklch(0.769 0.188 70.08)",
      "warning-foreground": "oklch(0.205 0 0)",
      "info": "oklch(0.546 0.245 262.881)",
      "info-foreground": "oklch(0.985 0 0)"
    },
    "dark": {
      "success": "oklch(0.765 0.177 163.223)",
      "success-foreground": "oklch(0.205 0 0)",
      "warning": "oklch(0.828 0.189 84.429)",
      "warning-fill": "oklch(0.769 0.188 70.08)",
      "warning-foreground": "oklch(0.205 0 0)",
      "info": "oklch(0.707 0.165 254.624)",
      "info-foreground": "oklch(0.205 0 0)"
    }
  },
  "css": {
    "@keyframes layro-fade-in": {
      "from": {
        "opacity": "0"
      }
    },
    "@keyframes layro-fade-out": {
      "to": {
        "opacity": "0"
      }
    },
    "@keyframes layro-pop-in": {
      "from": {
        "opacity": "0",
        "transform": "scale(0.96) translateY(var(--pop-y, -4px))"
      }
    },
    "@keyframes layro-pop-out": {
      "to": {
        "opacity": "0",
        "transform": "scale(0.97)"
      }
    },
    "@keyframes layro-dialog-in": {
      "from": {
        "opacity": "0",
        "transform": "translateY(8px) scale(0.97)"
      }
    },
    "@keyframes layro-dialog-out": {
      "to": {
        "opacity": "0",
        "transform": "translateY(4px) scale(0.98)"
      }
    },
    "@keyframes layro-shimmer": {
      "from": {
        "background-position": "200% 0"
      },
      "to": {
        "background-position": "-200% 0"
      }
    },
    "@keyframes layro-caret": {
      "50%": {
        "opacity": "0"
      }
    },
    "@keyframes layro-word-in": {
      "from": {
        "opacity": "0",
        "filter": "blur(3px)"
      }
    },
    "@keyframes layro-dot": {
      "0%, 60%, 100%": {
        "transform": "translateY(0)",
        "opacity": "0.35"
      },
      "30%": {
        "transform": "translateY(-3px)",
        "opacity": "1"
      }
    }
  },
  "type": "registry:style"
}